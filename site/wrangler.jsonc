// The download page at https://nousatlas.lionthroat.com: a static-files-only
// Cloudflare Worker. Deploy from this folder:  npx wrangler@4 deploy
// Preview locally:                              npx wrangler@4 dev
{
  "name": "nousatlas-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "nousatlas.lionthroat.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
